BACKEND_PORT=8080
VERDICT_ENGINE_PORT=8000
FRONTEND_PORT=5173
AUDIT_LOG_PATH=/data/audit_log.jsonl

# Required. No default — setup.sh refuses to start if this is unset or
# shorter than 12 characters.
MIRRAURA_ADMIN_USER=admin
MIRRAURA_ADMIN_PASSWORD=

# Optional: path (inside the backend container) to a JSON file of extra
# users, e.g. {"username": "...", "bcrypt_hash": "...", "role": "analyst"}.
# The repo root's users.json is bind-mounted into the container at
# /app/users.json (see docker-compose.yml) — set this to /app/users.json
# and edit that local file to add users. Generate a hash with:
# go run ./backend/cmd/hashpw <password>
MIRRAURA_USERS_PATH=

# Postgres (data stores are being migrated here across several tasks)
POSTGRES_PORT=5432
POSTGRES_PASSWORD=
BACKEND_DB_PASSWORD=
VERDICT_DB_PASSWORD=

# Shared secret between the backend and the host-side interceptor daemon
# (interceptor/) -- required if you run the daemon. Generate with e.g.
# `openssl rand -hex 32`.
INTERCEPTOR_TOKEN=

# Optional: OCI runtime for the shadow (detonation) container, e.g. "runsc"
# once gVisor is installed on the host and registered with the Docker
# daemon. Empty uses the daemon's configured default (runc).
SHADOW_RUNTIME=
